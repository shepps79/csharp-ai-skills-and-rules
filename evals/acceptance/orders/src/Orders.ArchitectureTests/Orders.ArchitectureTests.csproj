<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hidden from the agent: the provider copies it into the run dir after the agent finishes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- VersionOverride: the agent owns Directory.Packages.props, so this project can't rely on an entry there. -->
    <PackageReference Include="NetArchTest.Rules" VersionOverride="1.3.2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Orders.Api/Orders.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
