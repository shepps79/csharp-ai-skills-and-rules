--- /dev/null
+++ b/src/Orders.Application/CancelOrderUseCase.cs
@@ -0,0 +1,19 @@
+using CSharpFunctionalExtensions;
+
+namespace Orders.Application;
+
+/// <summary>Cancels an order that has not shipped yet.</summary>
+/// <param name="repository">Where orders are stored.</param>
+public sealed class CancelOrderUseCase(IOrderRepository repository)
+{
+    /// <summary>Cancels the order and stores the change.</summary>
+    /// <param name="orderId">Order to cancel.</param>
+    /// <param name="cancellationToken">Cancels the operation.</param>
+    /// <returns>The cancelled order, or why it could not be cancelled.</returns>
+    public Task<Result<OrderDto>> ExecuteAsync(Guid orderId, CancellationToken cancellationToken) =>
+        repository.FindByIdAsync(orderId, cancellationToken)
+            .ToResult($"Order {orderId} was not found.")
+            .Bind(order => order.Cancel())
+            .Tap(order => repository.UpdateAsync(order, cancellationToken))
+            .Map(OrderDto.From);
+}
