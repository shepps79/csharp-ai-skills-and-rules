+
+    /// <summary>Cancels the order, provided it has not shipped yet.</summary>
+    /// <returns>The cancelled order, or why it cannot be cancelled.</returns>
+    public Result<Order> Cancel() =>
+        Status == OrderStatus.Pending
+            ? Result.Success(this with { Status = OrderStatus.Cancelled })
+            : Result.Failure<Order>($"Only pending orders can be cancelled; this order is {Status}.");
 }
