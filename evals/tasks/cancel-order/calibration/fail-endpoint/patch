+using CSharpFunctionalExtensions;
+using Orders.Domain;
+
+namespace Orders.Application;
+
+/// <summary>Cancels an order.</summary>
+public sealed class CancelOrderUseCase(IOrderRepository repository)
+{
+    /// <summary>Builds the cancelled copy of an order.</summary>
+    private static Order Cancelled(Order order) => order with { Status = OrderStatus.Cancelled };
+
+    /// <summary>Loads an order.</summary>
+    public Task<Maybe<Order>> LoadAsync(Guid orderId, CancellationToken cancellationToken) =>
+        repository.FindByIdAsync(orderId, cancellationToken);
+
+    /// <summary>Stores the cancelled order.</summary>
+    public async Task<OrderDto> ExecuteAsync(Order order, CancellationToken cancellationToken)
+    {
+        var cancelled = Cancelled(order);
+        await repository.UpdateAsync(cancelled, cancellationToken);
+        return OrderDto.From(cancelled);
+    }
+}
