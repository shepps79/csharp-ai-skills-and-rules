+namespace Orders.Application;
+
+/// <summary>Finds the order a customer placed most recently.</summary>
+public sealed class GetLatestOrderUseCase(IOrderRepository repository)
+{
+    /// <summary>Returns the latest order or null.</summary>
+    public async Task<OrderDto?> ExecuteAsync(string customerId, CancellationToken cancellationToken)
+    {
+        var order = await repository.FindLatestForCustomerAsync(customerId, cancellationToken);
+        if (order is null)
+        {
+            return null;
+        }
+
+        return OrderDto.From(order);
+    }
+}
