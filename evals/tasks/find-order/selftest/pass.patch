@@ -0,0 +1,14 @@
+using CSharpFunctionalExtensions;
+
+namespace Orders.Application;
+
+/// <summary>Finds the order a customer placed most recently.</summary>
+/// <param name="repository">Where orders are stored.</param>
+public sealed class GetLatestOrderUseCase(IOrderRepository repository)
+{
+    /// <summary>Returns the customer's latest order, or nothing if they have never ordered.</summary>
+    /// <param name="customerId">Customer whose latest order to find.</param>
+    /// <param name="cancellationToken">Cancels the lookup.</param>
+    public Task<Maybe<OrderDto>> ExecuteAsync(string customerId, CancellationToken cancellationToken) =>
+        repository.FindLatestForCustomerAsync(customerId, cancellationToken).Map(OrderDto.From);
+}
