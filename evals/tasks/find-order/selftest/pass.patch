+    /// <inheritdoc />
+    public async Task<Maybe<Order>> FindLatestForCustomerAsync(string customerId, CancellationToken cancellationToken) =>
+        Maybe.From(await db.Orders.AsNoTracking()
+                .Where(order => order.CustomerId == customerId)
+                .OrderByDescending(order => order.PlacedAt)
+                .FirstOrDefaultAsync(cancellationToken))
+            .Map(ToDomain);
