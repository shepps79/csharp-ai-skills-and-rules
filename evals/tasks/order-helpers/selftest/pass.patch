+namespace Orders.Domain;
+
+/// <summary>Calculations over sets of order lines.</summary>
+public static class OrderLineExtensions
+{
+    extension(IEnumerable<OrderLine> lines)
+    {
+        /// <summary>Total value of the lines.</summary>
+        public decimal Total() => lines.Sum(line => line.Quantity * line.UnitPrice);
+
+        /// <summary>Whether any line is for the given SKU.</summary>
+        /// <param name="sku">SKU to look for.</param>
+        public bool ContainsSku(string sku) => lines.Any(line => line.Sku == sku);
+    }
+}
