+namespace Orders.Application;
+
+/// <summary>Exports every order for reconciliation.</summary>
+/// <param name="repository">Where orders are stored.</param>
+public sealed class ExportOrdersUseCase(IOrderRepository repository)
+{
+    /// <summary>Streams all orders in their caller-facing shape.</summary>
+    public IAsyncEnumerable<OrderDto> Execute() => repository.StreamAll().Select(OrderDto.From);
+}
