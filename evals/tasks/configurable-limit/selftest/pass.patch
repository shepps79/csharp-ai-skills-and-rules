@@ -0,0 +1,22 @@
+using Microsoft.Extensions.Options;
+using Orders.Application;
+
+namespace Orders.Api;
+
+/// <summary>Registers order limit configuration.</summary>
+public static class OrderLimitsRegistration
+{
+    extension(IHostApplicationBuilder builder)
+    {
+        /// <summary>Binds <see cref="OrderLimitsOptions"/> and validates it at startup.</summary>
+        public IHostApplicationBuilder AddOrderLimits()
+        {
+            builder.Services.AddOptions<OrderLimitsOptions>()
+                .Bind(builder.Configuration.GetSection(OrderLimitsOptions.SectionName))
+                .ValidateDataAnnotations()
+                .ValidateOnStart();
+            builder.Services.AddSingleton(services => services.GetRequiredService<IOptions<OrderLimitsOptions>>().Value);
+            return builder;
+        }
+    }
+}
