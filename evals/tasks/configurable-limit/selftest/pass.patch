@@ -0,0 +1,14 @@
+using System.ComponentModel.DataAnnotations;
+
+namespace Orders.Application;
+
+/// <summary>Limits applied when placing orders.</summary>
+public sealed class OrderLimitsOptions
+{
+    /// <summary>Configuration section holding these options.</summary>
+    public const string SectionName = "OrderLimits";
+
+    /// <summary>Most lines a single order may contain.</summary>
+    [Range(1, int.MaxValue)]
+    public int MaxLinesPerOrder { get; init; } = 50;
+}
