+using AwesomeAssertions;
+using Orders.Application;
+using Orders.Domain;
+
+namespace Orders.UnitTests.Application;
+
+public sealed class OrderDtoTests
+{
+    [Theory]
+    [InlineData("0123abcd-0000-0000-0000-000000000000", "ORD-0123ABCD")]
+    [InlineData("ffffffff-1111-2222-3333-444444444444", "ORD-FFFFFFFF")]
+    public void Number_IsOrdPrefixAndFirstEightHexDigits(string id, string expected)
+    {
+        var order = new Order { Id = Guid.Parse(id), CustomerId = "cust-1", Lines = [new OrderLine("SKU-1", 1, 5m)], Status = OrderStatus.Pending };
+
+        OrderDto.From(order).Number.Should().Be(expected);
+    }
+}
