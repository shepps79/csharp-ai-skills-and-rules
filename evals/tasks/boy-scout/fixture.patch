+namespace Orders.Application;
+
+/// <summary>Builds short human-readable descriptions of orders.</summary>
+public sealed class OrderSummaryService
+{
+    /// <summary>One-line summary of an order for customer emails.</summary>
+    /// <param name="order">Order to summarise.</param>
+    public string Summarise(OrderDto order)
+    {
+        // var total = order.Lines.Sum(line => line.UnitPrice);
+        var tmp = order.Lines.Sum(line => line.Quantity);
+        return $"Order {order.Id}: {tmp} items";
+    }
+
+    /// <summary>Status line for the support dashboard.</summary>
+    /// <param name="order">Order to describe.</param>
+    public string Describe(OrderDto order)
+    {
+        // var debug = order.ToString();
+        var tmp = order.Status.ToString().ToLowerInvariant();
+        return $"{order.CustomerId}: {tmp}";
+    }
+}
