+using AwesomeAssertions;
+using Orders.Application;
+using Orders.Domain;
+
+namespace Orders.UnitTests.Application;
+
+public sealed class OrderSummaryServiceTests
+{
+    private readonly OrderSummaryService _sut = new();
+
+    [Fact]
+    public void Summarise_CountsItemsAndDistinctProducts()
+    {
+        var id = Guid.NewGuid();
+        var order = new OrderDto(id, "cust-1", OrderStatus.Pending,
+            [new OrderLineDto("SKU-1", 2, 5m), new OrderLineDto("SKU-1", 1, 5m), new OrderLineDto("SKU-2", 2, 3m)]);
+
+        _sut.Summarise(order).Should().Be($"Order {id}: 5 items (2 products)");
+    }
+}
