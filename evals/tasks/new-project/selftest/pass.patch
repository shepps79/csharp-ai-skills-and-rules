@@ -0,0 +1,18 @@
+using System.Net.Mail;
+using Orders.Application;
+
+namespace Orders.Email;
+
+/// <summary>Emails customers about their orders over SMTP.</summary>
+/// <param name="client">Configured SMTP client.</param>
+public sealed class SmtpOrderNotifier(SmtpClient client) : IOrderNotifier
+{
+    private const string Sender = "orders@example.com";
+
+    /// <inheritdoc />
+    public async Task NotifyOrderPlacedAsync(OrderDto order, CancellationToken cancellationToken)
+    {
+        using var message = new MailMessage(Sender, order.CustomerId, "Your order has been placed", $"Thanks for your order {order.Id}.");
+        await client.SendMailAsync(message, cancellationToken);
+    }
+}
