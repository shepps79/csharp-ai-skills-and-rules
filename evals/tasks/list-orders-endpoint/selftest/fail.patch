diff --git a/src/Orders.Api/Program.cs b/src/Orders.Api/Program.cs
index 54847b6..632983e 100644
--- a/src/Orders.Api/Program.cs
+++ b/src/Orders.Api/Program.cs
@@ -11,4 +11,14 @@ builder.Services.AddScoped<PlaceOrderUseCase>();
 
 var app = builder.Build();
 
+app.MapGet("/customers/{customerId}/orders", (string customerId, string? status, OrdersDbContext db) =>
+{
+    var all = db.Orders.ToList();
+    var mine = all.Where(o => o.CustomerId == customerId && (status == null || o.Status == status));
+    return new CustomerOrdersResponse
+    {
+        Orders = mine.Select(o => new OrderDto(o.Id, o.CustomerId, Enum.Parse<Orders.Domain.OrderStatus>(o.Status), o.Lines.Select(l => new OrderLineDto(l.Sku, l.Quantity, l.UnitPrice)).ToList())).ToList(),
+    };
+});
+
 app.Run();
