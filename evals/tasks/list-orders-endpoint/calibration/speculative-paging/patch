+using AwesomeAssertions;
+using CSharpFunctionalExtensions;
+using Moq;
+using Orders.Application;
+using Orders.Domain;
+
+namespace Orders.UnitTests.Application;
+
+public sealed class ListCustomerOrdersUseCaseTests
+{
+    private readonly Mock<IOrderRepository> _repository = new();
+    private readonly ListCustomerOrdersUseCase _sut;
+
+    public ListCustomerOrdersUseCaseTests()
+    {
+        _sut = new ListCustomerOrdersUseCase(_repository.Object);
+    }
+
+    [Fact]
+    public async Task ExecuteAsync_ReturnsCustomersOrdersAsDtos()
+    {
+        // Arrange
+        var order = new Order { Id = Guid.NewGuid(), CustomerId = "cust-1", Lines = [new OrderLine("SKU-1", 1, 5m)], Status = OrderStatus.Pending };
+        _repository
+            .Setup(r => r.ListByCustomerAsync("cust-1", Maybe<OrderStatus>.None, It.IsAny<CancellationToken>()))
+            .ReturnsAsync([order]);
+
+        // Act
+        var result = await _sut.ExecuteAsync("cust-1", Maybe<OrderStatus>.None, TestContext.Current.CancellationToken);
+
+        // Assert
+        result.Should().ContainSingle().Which.Id.Should().Be(order.Id);
+    }
+}
