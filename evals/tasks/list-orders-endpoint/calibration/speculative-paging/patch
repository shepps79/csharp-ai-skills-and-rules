+using CSharpFunctionalExtensions;
+using Orders.Domain;
+
+namespace Orders.Application;
+
+/// <summary>Lists a customer's orders.</summary>
+/// <param name="repository">Where orders are stored.</param>
+public sealed class ListCustomerOrdersUseCase(IOrderRepository repository)
+{
+    /// <summary>Returns the customer's orders, optionally only those in one status.</summary>
+    /// <param name="customerId">Customer whose orders to list.</param>
+    /// <param name="status">Status to filter by, or none for every status.</param>
+    /// <param name="cancellationToken">Cancels the query.</param>
+    /// <param name="page">1-based page number.</param>
+    /// <param name="pageSize">Orders per page.</param>
+    /// <param name="sortBy">Field to sort by: "id" or "customer".</param>
+    public async Task<IReadOnlyList<OrderDto>> ExecuteAsync(string customerId, Maybe<OrderStatus> status, int page, int pageSize, string sortBy, CancellationToken cancellationToken) =>
+        [.. (await repository.ListByCustomerAsync(customerId, status, cancellationToken))
+            .OrderBy(order => sortBy == "customer" ? order.CustomerId : order.Id.ToString())
+            .Skip((page - 1) * pageSize)
+            .Take(pageSize)
+            .Select(OrderDto.From)];
+}
