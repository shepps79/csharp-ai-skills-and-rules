+    /// <inheritdoc />
+    public async Task<IReadOnlyList<Order>> ListByCustomerAsync(string customerId, Maybe<OrderStatus> status, CancellationToken cancellationToken)
+    {
+        var orders = db.Orders.AsNoTracking().Where(order => order.CustomerId == customerId);
+        var filtered = status.Match(
+            wanted => orders.Where(order => order.Status == wanted.ToString()),
+            () => orders);
+        return [.. (await filtered.ToListAsync(cancellationToken)).Select(ToDomain)];
+    }
