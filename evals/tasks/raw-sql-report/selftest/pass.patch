+namespace Orders.Application;
+
+/// <summary>Reports how many orders each customer has in each status.</summary>
+/// <param name="repository">Where orders are stored.</param>
+public sealed class OrdersByStatusReportUseCase(IOrderRepository repository)
+{
+    /// <summary>Streams the report rows.</summary>
+    public IAsyncEnumerable<CustomerStatusCount> Execute() => repository.CountByCustomerAndStatus();
+}
