+using Moq;
+using Orders.Application;
+using Orders.Domain;
+
+namespace Orders.UnitTests.Application;
+
+public class GetOrderUseCaseTests
+{
+    // ---------- GetOrder ----------
+
+    [Fact]
+    public async Task TestGetOrder()
+    {
+        var repository = new Mock<IOrderRepository>();
+        var sut = new GetOrderUseCase(repository.Object);
+
+        var result = await sut.ExecuteAsync(Guid.NewGuid(), CancellationToken.None);
+
+        if (result.HasValue)
+        {
+            Assert.Fail("expected no order");
+        }
+    }
+}
