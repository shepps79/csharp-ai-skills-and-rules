# Compiler-enforced subset of .claude/rules. Each section names the rule it enforces.
# Build enforcement needs Directory.Build.props (next to this file) with EnforceCodeStyleInBuild,
# GenerateDocumentationFile and TreatWarningsAsErrors; without them most IDE* rules only show in the editor.
# Rules that no built-in analyzer can check (member ordering, function length, parameter count, LINQ over loops,
# commented-out code, sealed public classes, InternalsVisibleTo) stay with the prose rules and code review.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,json,yaml,yml}]
indent_size = 2

[*.cs]

# --- clean-code.md RULE-005: consistent formatting -----------------------------------------------
dotnet_diagnostic.IDE0055.severity = warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0065.severity = warning

# --- dotnet.md Code Style: file-scoped namespaces (enforced at warning level) --------------------
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# --- dotnet.md Code Style: braces required for all control flow ----------------------------------
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# --- dotnet.md Naming: var when the type is apparent; language keywords over framework types -----
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_diagnostic.IDE0007.severity = warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_diagnostic.IDE0049.severity = warning

# --- dotnet.md General: remove unused usings, parameters and dead code (Boy Scout Rule) ----------
# clean-code.md RULE-004, simple-design.md RULE-004
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0035.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_code_quality_unused_parameters = all:warning
dotnet_diagnostic.IDE0060.severity = warning

# --- dotnet.md General: low cyclomatic complexity -------------------------------------------------
dotnet_diagnostic.CA1502.severity = warning

# --- dotnet.md General: XML docs on all public members --------------------------------------------
dotnet_diagnostic.CS1591.severity = warning

# --- dotnet.md Code Style: redundant qualifiers; nameof over typeof(...).Name / string literals --
dotnet_diagnostic.IDE0001.severity = warning
dotnet_diagnostic.IDE0002.severity = warning
dotnet_diagnostic.IDE0082.severity = warning
dotnet_diagnostic.CA1507.severity = warning

# --- dotnet.md Code Style: ArgumentNullException.ThrowIfNull --------------------------------------
dotnet_diagnostic.CA1510.severity = warning

# --- dotnet.md Code Style: prefer primary constructors ---------------------------------------------
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_diagnostic.IDE0290.severity = suggestion

# --- dotnet.md Code Style: structured logging, never interpolation ---------------------------------
dotnet_diagnostic.CA2254.severity = warning
dotnet_diagnostic.CA1727.severity = warning

# --- dotnet.md Code Style: sealed classes (only internal types can be detected) --------------------
dotnet_diagnostic.CA1852.severity = warning

# --- dotnet.md Code Style: implement every switch branch -------------------------------------------
dotnet_diagnostic.IDE0010.severity = warning
dotnet_diagnostic.IDE0072.severity = warning

# --- dotnet.md Code Style / Async: pass CancellationToken; always await ---------------------------
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA1068.severity = warning
dotnet_diagnostic.CA1849.severity = warning
dotnet_diagnostic.CA2012.severity = warning

# --- dotnet-functional.md: immutability (readonly fields and structs) -----------------------------
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0250.severity = warning
dotnet_diagnostic.IDE0251.severity = warning

# --- dotnet-functional.md: expression-bodied members for single expressions -----------------------
csharp_style_expression_bodied_methods = true:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_indexers = true:warning
csharp_style_expression_bodied_lambdas = true:warning
csharp_style_expression_bodied_local_functions = true:warning
csharp_style_expression_bodied_operators = true:warning
csharp_style_expression_bodied_constructors = false:silent
dotnet_diagnostic.IDE0022.severity = warning
dotnet_diagnostic.IDE0025.severity = warning
dotnet_diagnostic.IDE0026.severity = warning
dotnet_diagnostic.IDE0027.severity = warning
dotnet_diagnostic.IDE0053.severity = warning
dotnet_diagnostic.IDE0061.severity = warning
dotnet_diagnostic.IDE0023.severity = warning
dotnet_diagnostic.IDE0024.severity = warning

# --- dotnet-csharp14-idioms.md: field keyword (auto-properties over manual backing fields) -------
dotnet_style_prefer_auto_properties = true:warning
dotnet_diagnostic.IDE0032.severity = warning

# --- dotnet-csharp14-idioms.md: collection expressions -------------------------------------------
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning

# --- dotnet-csharp14-idioms.md: switch expressions and pattern matching; no nested property patterns
csharp_style_prefer_switch_expression = true:warning
dotnet_diagnostic.IDE0066.severity = warning
csharp_style_prefer_pattern_matching = true:warning
dotnet_diagnostic.IDE0078.severity = warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
dotnet_diagnostic.IDE0019.severity = warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
dotnet_diagnostic.IDE0020.severity = warning
csharp_style_prefer_not_pattern = true:warning
dotnet_diagnostic.IDE0083.severity = warning
csharp_style_prefer_extended_property_pattern = true:warning
dotnet_diagnostic.IDE0170.severity = warning

# --- testing.md: pass TestContext.Current.CancellationToken in tests (xUnit v3 analyzer) ---------
dotnet_diagnostic.xUnit1051.severity = warning

# --- clean-code.md RULE-001/RULE-104, dotnet.md Naming: no underscores in identifiers -----------
dotnet_diagnostic.CA1707.severity = warning

# --- dotnet.md Naming --------------------------------------------------------------------------
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async

# Interfaces: IPascalCase
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = interface_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = warning

# Async methods: Async suffix
dotnet_naming_symbols.async_methods.applicable_kinds = method, local_function
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_rule.async_methods_end_with_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_with_async.style = async_suffix
dotnet_naming_rule.async_methods_end_with_async.severity = warning

# Constants and static readonly fields: PascalCase
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_fields_are_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal_case.severity = warning

# Private fields: _camelCase
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning

# Locals and parameters: camelCase
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter
dotnet_naming_rule.locals_and_parameters_are_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_are_camel_case.style = camel_case
dotnet_naming_rule.locals_and_parameters_are_camel_case.severity = warning

# Types and members: PascalCase
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, method, property, event, namespace, local_function
dotnet_naming_rule.types_and_members_are_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_members_are_pascal_case.severity = warning

# --- testing.md: tests are named Method_ExpectedBehavior_Scenario, async without the Async suffix,
# and need no XML docs (they are not a public API) ----------------------------------------------
[**/*Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CS1591.severity = none
dotnet_naming_rule.async_methods_end_with_async.severity = none
